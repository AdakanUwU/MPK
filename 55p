<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>Obieg pojazdu - Tabela</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #f0f2f5;
            color: #1a202c;
            padding: 30px;
            max-width: 900px;
            margin: 0 auto;
        }
        h1 {
            font-size: 1.4rem;
            color: #2b6cb0;
            border-bottom: 2px solid #cbd5e0;
            padding-bottom: 8px;
            margin-bottom: 20px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background: #ffffff;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
            border-radius: 8px;
            overflow: hidden;
        }
        th, td {
            padding: 14px 18px;
            border-bottom: 1px solid #edf2f7;
            text-align: left;
        }
        th {
            background-color: #2b6cb0;
            color: white;
            font-weight: 600;
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        tr:last-child td {
            border-bottom: none;
        }
        tr:hover {
            background-color: #f7fafc;
        }
        .day-label {
            font-weight: bold;
            color: #2d3748;
            white-space: nowrap;
        }
        .train-badge {
            display: inline-block;
            background: #edf2f7;
            border: 1px solid #cbd5e0;
            padding: 4px 8px;
            border-radius: 4px;
            font-family: monospace;
            font-weight: bold;
            color: #1a202c;
            margin: 2px 4px 2px 0;
        }
        .arrow {
            color: #a0aec0;
            margin-right: 4px;
            font-weight: bold;
        }
        .note {
            font-size: 0.85rem;
            color: #718096;
            margin-top: 15px;
        }
    </style>
</head>
<body>

    <h1>Obieg jednostki (np. 612)</h1>
    
    <table>
        <thead>
            <tr>
                <th style="width: 15%;">Dzień</th>
                <th style="width: 85%;">Relacje / Pociągi w obiegach</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="day-label">Dzień 1</td>
                <td>
                    <span class="train-badge">44431</span> <span class="note">(Lubliniec)</span>
                    <span class="arrow">&rarr;</span>
                    <span class="train-badge">44233</span>
                    <span class="arrow">&rarr;</span>
                    <span class="train-badge">44234</span>
                    <span class="arrow">&rarr;</span>
                    <span class="train-badge">44239</span>
                </td>
            </tr>
            <tr>
                <td class="day-label">Dzień 2</td>
                <td>
                    <span class="train-badge">44240</span>
                    <span class="arrow">&rarr;</span>
                    <span class="train-badge">44243</span>
                    <span class="arrow">&rarr;</span>
                    <span class="train-badge">44246</span>
                    <span class="arrow">&rarr;</span>
                    <span class="train-badge">44237</span>
                    <span class="arrow">&rarr;</span>
                    <span class="train-badge">44224</span>
                    <span class="arrow">&rarr;</span>
                    <span class="train-badge">44249</span>
                </td>
            </tr>
            <tr>
                <td class="day-label">Dzień 3</td>
                <td>
                    <span class="train-badge">44226</span>
                    <span class="arrow">&rarr;</span>
                    <span class="train-badge">44229</span>
                    <span class="arrow">&rarr;</span>
                    <span class="train-badge">44230</span>
                    <span class="arrow">&rarr;</span>
                    <span class="train-badge">44245</span> <span class="note">(TG &rarr; Częstochowa - zjazd)</span>
                </td>
            </tr>
        </tbody>
    </table>

    <div class="note">Wygenerowano automatycznie dla układu obiegowego.</div>

</body>
</html>
